{
  "name": "docs",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client && tsc -p tests",
    "test": "vitest run",
    "e2e": "playwright test --project=chrome",
    "e2e:all": "playwright test",
    "perf": "playwright test --config playwright.perf.config.ts --project=chrome",
    "backup": "npm run backup -w server"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@unicode/unicode-16.0.0": "2.0.7",
    "concurrently": "^10.0.6",
    "emojibase-data": "^17.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  }
}
